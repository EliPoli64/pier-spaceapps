# PIER — Environment variable placeholders
# =========================================
# Never commit real credentials. Demo mode (PIER_DEMO_MODE=1, default)
# does not use Earthdata; all demo data is served from piper_agent/data/cache/.
#
# To run with live NASA data (production path only), set the following
# with valid Earthdata credentials. The demo will automatically fall back
# to cache if any key is missing or invalid.

# PIER — Environment variable placeholders
# =========================================
# NEVER commit real credentials. Demo mode (PIER_DEMO_MODE=1, default)
# does not use Earthdata; all demo data is served from
# piper_agent/data/cache/ and piper_agent/data/baselines/.
#
# To run with live NASA / partner data (production path only), set the
# relevant keys below with valid credentials. The pipeline falls back to
# synthetic cache automatically when a key is missing or a call fails.
#
# Official policy: live-data path is opt-in and labeled in the output via
# `fuente_datos`. See docs/AI_USAGE_DECLARATION.md and
# PLAN_SEIS_PERSONAS.md ("Next Wave: Real Data, Real Results").

# --- Mode toggle ---
# 1 = demo mode (cache-only, no live NASA/partner calls, recommended default)
# 0 = production path (live NASA Earthdata/POWER + partner data, opt-in only)
#
# Production path (PIER_DEMO_MODE=0) requires:
#   - At least EARTHDATA_USERNAME and EARTHDATA_PASSWORD set for the live
#     POWER/IMERG path (never commit real credentials)
#   - All existing tests continue to run with demo_mode=True (no test changes)
#   - Live API calls are opt-in and labeled as "nasa_power" or "nasa_power+imerg"
#   - Graceful fallback to synthetic cache if APIs fail (circuit breaker)
PIER_DEMO_MODE=1

# --- Earthdata / NASA (live POWER + IMERG path, not required for demo) ---
# Earthdata credentials used by the live POWER and IMERG path.
# POWER is public (no auth); IMERG via imergpy needs Earthdata OTF cookies.
# Without both, the pipeline uses POWER PRECTOTCORR as a declared rainfall
# substitute and labels the result "nasa_power" instead of "nasa_power+imerg".
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# Optional override of the public POWER endpoint (useful for mirrors / tests).
PIER_POWER_BASE=https://power.larc.nasa.gov/api/temporal/daily/point

# --- OpenET (optional, production path) ---
# OpenET actual evapotranspiration API key.
# Available at https://openet.farms.io/ (free tier, register an account).
# Without this key, fetch_openet_eta() falls back to Hargreaves ET0 from POWER
# and labels the result "nasa_power_hargreaves" instead of "en_vivo".
PIER_OPENET_API_KEY=your_openet_key
PIER_OPENET_BASE=https://api.openet.io/api/v1

# --- SMAP soil moisture (optional, production path) ---
# NASA SMAP API key for real root-zone soil moisture.
# Without this key, fetch_smap_moisture() falls back to POWER GWETROOT and
# labels the result "nasa_power_gwetroot" instead of "en_vivo".
PIER_SMAP_API_KEY=your_smap_key
PIER_SMAP_BASE=https://nsidc.org/api/smap/v1

# --- SoilGrids / ISRIC (optional, production path) ---
# Soil texture lookup base URL (SoilGrids v2.0 REST).
# Without network access, lookup_soil() falls back to a climate-zone estimate.
PIER_SOILGRIDS_BASE=https://rest.isric.org/soilgrids/v2.0/properties/query

# --- Redis (optional, production ingestion pipeline) ---
# Redis connection string; if omitted, the filesystem fallback is used.
# PIER_REDIS_HOST=redis://localhost:6379

# --- Calibration & monitoring ---
# Where farmer observations and local correction factors are stored.
# Default: piper_agent/data/cache/calibracion/ (gitignored).
# PIER_CALIBRACION_DIR=./data/cache/calibracion

# Thresholds used by monitoring/drift checks and low-confidence tags.
PIER_STALE_DATA_HOURS=72
PIER_LOW_CONFIDENCE=0.5

# Circuit breaker tuning for live-data calls (shared across ingestion modules).
# After this many consecutive failures the live path is opened and synthetic
# cache is used until the breaker resets.
PIER_CB_THRESHOLD=3
PIER_CB_RESET=300

# --- API & server ---
PIER_API_HOST=127.0.0.1
PIER_API_PORT=8000

# API key for the FastAPI auth gate (Danny's production hardening).
# When unset, the API runs without the X-API-Key gate (demo-safe default).
# PIER_API_KEY=your_api_key_here

# CORS allowlist for the API (comma-separated origins). "*" allows all.
# PIER_CORS_ORIGINS=*

# Rate limit for the API (requests per window per API key / client IP).
# PIER_RATE_LIMIT_MAX=120
# PIER_RATE_LIMIT_WINDOW=60

# --- Python version consistency ---
# Keep in sync with AI_USAGE_DECLARATION.md (currently 3.11).
PYTHON_VERSION=3.11