# PIER — Environment variable placeholders
# =========================================
# Never commit real credentials. Demo mode (PIER_DEMO_MODE=1, default)
# does not use Earthdata; all demo data is served from piper_agent/data/cache/.
#
# To run with live NASA data (production path only), set the following
# with valid Earthdata credentials. The demo will automatically fall back
# to cache if any key is missing or invalid.

# --- Earthdata (live IMERG/POWER path, not required for demo) ---
EARTHDATA_USERNAME=your_username
EARTHDATA_PASSWORD=your_password

# --- OpenET (optional, v1.1+) ---
# OpenET actual evapotranspiration API key (free tier available at openet.farms.io)
PIER_OPENET_API_KEY=your_openet_key

# --- SMAP soil moisture (optional, v1.1+) ---
# NASA SMAP API key (optional; demo uses synthetic fallback)
PIER_SMAP_API_KEY=your_smap_key

# --- Redis (optional, v1.1+ for production ingestion pipeline) ---
# Redis connection host; if omitted, filesystem fallback is used
PIER_REDIS_HOST=redis://localhost:6379

# --- Monitoring & drift detection ---
# Stale-data threshold in hours; if IMERG data older than this, drift alert triggers
PIER_STALE_DATA_HOURS=72

# Low-confidence threshold; recommendations below this get a "review" tag
PIER_LOW_CONFIDENCE=0.5

# --- Demo mode ---
# 1 = demo mode (cache-only, no live NASA calls, recommended for hackathon)
# 0 = production path (live NASA Earthdata/POWER calls, opt-in only)
#
# IMPORTANT: Production path (PIER_DEMO_MODE=0) requires:
#   - EARTHDATA_USERNAME and EARTHDATA_PASSWORD set (never commit real credentials)
#   - All 95 tests continue to run with demo_mode=True (no changes)
#   - Live API calls are opt-in, labeled as "nasa_power" or "nasa_power+imerg"
#   - Graceful fallback to synthetic cache if APIs fail (circuit breaker)
PIER_DEMO_MODE=1

# --- API & server ---
# FastAPI host and port
PIER_API_HOST=127.0.0.1
PIER_API_PORT=8000

# --- Version & config ---
# Python version consistency: keep matching AI_USAGE_DECLARATION.md (currently 3.11)
PYTHON_VERSION=3.11