server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # Proxy the browser's /api/* calls to the FastAPI service.
    # The trailing slash on proxy_pass strips the /api/ prefix, so
    # /api/generate_plan becomes /generate_plan on the API.
    # PIER_API_URL and PIER_API_KEY are substituted by the official
    # nginx image's envsubst entrypoint at container start.
    location /api/ {
        proxy_pass ${PIER_API_URL}/;
        proxy_http_version 1.1;
        # Railway serves the API on an https:// public domain. Without SNI the
        # TLS handshake to that shared edge fails and nginx answers 502, so send
        # the upstream hostname as the SNI name. Both settings are ignored for
        # plain http:// upstreams (local Compose uses http://api:8000).
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key "${PIER_API_KEY}";
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }

    # Hashed Vite assets are immutable.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Single-page app fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
