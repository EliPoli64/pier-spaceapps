# PIER web UI — React + Vite built with Node and served by Nginx.
# Used by the Railway `web` service (see .github/workflows/deploy-web.yml).
#
# The build context is the repository root so Railway can upload the project
# once and reuse it for the API, Streamlit UI and web services.
FROM node:24-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

FROM nginx:alpine

# The official nginx image expands /etc/nginx/templates/*.template into
# /etc/nginx/conf.d/default.conf at startup using the container environment.
COPY frontend/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY frontend/nginx/19-pier-env.envsh /docker-entrypoint.d/19-pier-env.envsh
COPY frontend/nginx/25-listen-on-ipv6.sh /docker-entrypoint.d/25-listen-on-ipv6.sh
RUN chmod +x /docker-entrypoint.d/19-pier-env.envsh /docker-entrypoint.d/25-listen-on-ipv6.sh
COPY --from=build /app/dist /usr/share/nginx/html

# Local Docker Compose default. Override with the API service URL on Railway.
ENV PIER_API_URL=http://api:8000
ENV PIER_API_KEY=

EXPOSE 80
